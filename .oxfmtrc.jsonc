// Mirrors vercel/ai's oxfmt configuration.
{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "avoid",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "endOfLine": "lf",
  "ignorePatterns": [
    ".changeset/**",
    "CHANGELOG.md",
    "dist/**",
    "pnpm-lock.yaml",
    "**/tsconfig*.json",
  ],
  "printWidth": 80,
  "quoteProps": "as-needed",
  "semi": true,
  "singleQuote": true,
  "sortPackageJson": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false,
}

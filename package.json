{
  "name": "dissent",
  "version": "0.0.1",
  "description": "Ask several AI models the same question and see where they disagree, before you ship. Built on the Vercel AI SDK.",
  "keywords": [
    "ai",
    "ai-sdk",
    "vercel-ai-sdk",
    "llm",
    "multi-model",
    "verification",
    "dissent"
  ],
  "license": "Apache-2.0",
  "author": "Mohamed Jadib (https://github.com/jadibdev)",
  "homepage": "https://github.com/jadibdev/dissent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jadibdev/dissent.git"
  },
  "bugs": {
    "url": "https://github.com/jadibdev/dissent/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint && oxfmt --check src scripts .github .changeset README.md package.json tsdown.config.ts vitest.config.ts",
    "format": "oxfmt src scripts .github .changeset README.md package.json tsdown.config.ts vitest.config.ts",
    "changeset": "changeset"
  },
  "peerDependencies": {
    "ai": "^7.0.162"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.101",
    "@ai-sdk/gateway": "4.0.141",
    "@ai-sdk/google": "4.0.116",
    "@ai-sdk/openai": "4.0.113",
    "@changesets/cli": "2.27.10",
    "@types/node": "22.19.19",
    "ai": "7.0.168",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "tsdown": "^0.23.0",
    "typescript": "6.0.3",
    "unrun": "^0.3.1",
    "vitest": "4.1.11",
    "zod": "^4.1.8"
  }
}
